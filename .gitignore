# https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# macOS filesystem generated
# https://stackoverflow.com/questions/18393498/gitignore-all-the-ds-store-files-in-every-folder-and-subfolder
.DS_Store
.DS_Store?

# python generated
__pycache__/

# setuptools generated
*.egg-info/

# images generated for in-code comparisons
*.png
# the figures of the docs pages, made by the scripts next to them
!docs/**/figures/*.png

# notebooks are tracked (see notebooks/README.md). Research and archive notebooks are committed
# with their outputs stripped (nbstripout in .pre-commit-config.yaml); demo and paper notebooks
# keep light outputs. What the notebooks write when they run stays out of git:
notebooks/**/output/
notebooks/**/*.mp4
notebooks/**/*.gif
notebooks/**/pickle/*.pickle
.ipynb_checkpoints/
# ...except the three small power-series pickles the test suite reads (270 KB in total),
# regenerated by scripts/generate_power_series_pickles.py
!notebooks/multiphysics/power-series/pickle/2D_1x2_up_to_2.pickle
!notebooks/multiphysics/power-series/pickle/4D_2x2_up_to_4.pickle
!notebooks/multiphysics/power-series/pickle/6D_3x2_up_to_6.pickle

# fortran build artefacts
fortran/build/
*.o
*.mod
a.out
*.x
# the fortran folder also held a scratch notebook and compiled binaries locally
fortran/*.ipynb
fortran/symmetric_group
fortran/symmetric_group_iterative

# python build artefacts
build/
dist/
*.egg-info/

# sphinx documentation build output (docs/_autosummary is generated from the docstrings, and
# docs/_notebooks holds the gallery notebooks that docs/conf.py copies in from notebooks/)
docs/_build/
docs/_autosummary/
docs/_notebooks/
